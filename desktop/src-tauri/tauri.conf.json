{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Penstock Community",
  "version": "0.1.0",
  "identifier": "systems.miguel.penstock.community",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "Penstock Community",
        "width": 960,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": ["launcher"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local workflow studio and optional on-device models",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "stage/backend/": "backend/",
      "stage/node/": "node/",
      "stage/inference/": "inference/",
      "stage/licenses/": "licenses/"
    },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
